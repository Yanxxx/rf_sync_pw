# BUILD file for the locally installed TI SimpleLink CC13xx/CC26xx SDK.
# Instantiated as @ti_simplelink_sdk by //third_party/ti_simplelink:ti_sdk.bzl.
#
# Devices: CC13x2x7 (e.g. CC1312R7) and CC26x2x7 (e.g. CC2652R7), Cortex-M4F,
# GCC, FreeRTOS. Each board's platform selects its family with one of the
# :cc13x2x7 / :cc26x2x7 constraint values below.
# The FreeRTOS kernel itself is NOT taken from the SDK: it comes from the
# @freertos Bazel module so that Pigweed's FreeRTOS backends share it.

load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(
    default_visibility = ["//visibility:public"],
    features = ["-layering_check"],
)

constraint_setting(name = "device_family")

constraint_value(
    name = "cc13x2x7",
    constraint_setting = ":device_family",
)

constraint_value(
    name = "cc26x2x7",
    constraint_setting = ":device_family",
)

# Keep in sync with SysConfig's ti_utils_build_compiler.opt.
cc_library(
    name = "device_defines",
    defines = select({
        ":cc13x2x7": ["DeviceFamily_CC13X2X7"],
        ":cc26x2x7": ["DeviceFamily_CC26X2X7"],
    }),
)

# TI driver/driverlib/log headers, included as <ti/...>.
cc_library(
    name = "headers",
    hdrs = glob(
        [
            "source/ti/devices/DeviceFamily.h",
            "source/ti/devices/cc13x2x7_cc26x2x7/**/*.h",
            "source/ti/drivers/**/*.h",
            "source/ti/log/**/*.h",
            "source/ti/posix/freertos/*.h",
        ],
        allow_empty = False,
    ),
    includes = ["source"],
    # ti_devices_config.c #includes the CCFG (customer configuration) source.
    textual_hdrs = ["source/ti/devices/cc13x2x7_cc26x2x7/startup_files/ccfg.c"],
    deps = [":device_defines"],
)

# TI's POSIX wrapper headers. They shadow newlib's <time.h>, <pthread.h>,
# <semaphore.h>, ... so only code that wants TI POSIX should depend on this.
cc_library(
    name = "posix_headers",
    hdrs = glob(["source/ti/posix/gcc/**/*.h"], allow_empty = False),
    includes = ["source/ti/posix/gcc"],
)

# TI Driver Porting Layer (DPL) for FreeRTOS, startup code and POSIX layer.
# This mirrors what SysConfig's ti_freertos_config.c pulls in, minus the
# kernel sources and minus StaticAllocs_freertos.c (Pigweed's
# //third_party/freertos:support provides the same idle/timer task memory
# callbacks).
cc_library(
    name = "freertos_dpl",
    srcs = [
        "kernel/freertos/dpl/AppHooks_freertos.c",
        "kernel/freertos/dpl/ClockPCC26X2_freertos.c",
        "kernel/freertos/dpl/DebugP_freertos.c",
        "kernel/freertos/dpl/EventP_freertos.c",
        "kernel/freertos/dpl/HwiPCC26X2_freertos.c",
        "kernel/freertos/dpl/MessageQueueP_freertos.c",
        "kernel/freertos/dpl/MutexP_freertos.c",
        "kernel/freertos/dpl/PowerCC26X2_freertos.c",
        "kernel/freertos/dpl/QueueP_freertos.c",
        "kernel/freertos/dpl/SemaphoreP_freertos.c",
        "kernel/freertos/dpl/SwiP_freertos.c",
        "kernel/freertos/dpl/SystemP_freertos.c",
        "kernel/freertos/dpl/TaskP_freertos.c",
        "kernel/freertos/dpl/TimerPCC26XX_freertos.c",
        "kernel/freertos/dpl/TimestampPCC26XX_freertos.c",
        "kernel/freertos/startup/startup_cc13x2_cc26x2_gcc.c",
        "source/ti/posix/freertos/clock.c",
        "source/ti/posix/freertos/memory.c",
        "source/ti/posix/freertos/mqueue.c",
        "source/ti/posix/freertos/pthread.c",
        "source/ti/posix/freertos/pthread_barrier.c",
        "source/ti/posix/freertos/pthread_cond.c",
        "source/ti/posix/freertos/pthread_mutex.c",
        "source/ti/posix/freertos/pthread_rwlock.c",
        "source/ti/posix/freertos/sched.c",
        "source/ti/posix/freertos/semaphore.c",
        "source/ti/posix/freertos/sleep.c",
        "source/ti/posix/freertos/timer.c",
    ] + glob([
        "kernel/freertos/dpl/*.h",
        "source/ti/posix/freertos/*.h",
    ]),
    copts = [
        "-std=c99",
        "-w",
    ],
    includes = [
        "kernel/freertos",
        "kernel/freertos/dpl",
    ],
    local_defines = ["TI_POSIX_FREERTOS_MEMORY_ENABLEADV"],
    deps = [
        ":headers",
        ":posix_headers",
        "@freertos",
    ],
    alwayslink = True,
)

# TI libraries built from source. The SDK on GitHub ships these as sources
# only (TI's installer also has prebuilt copies); the source lists follow TI's
# source/ti/drivers/CMakeSources_cc13xx_cc26xx.cmake (SOURCES_CC13X2_CC26X2)
# and source/ti/display/CMakeSources.cmake, and the flags follow TI's
# source/cmake/toolchains/gcc.cmake (-std=c11 -O3). Drivers that need extra
# third-party code (CAN/MCAN, SD/FatFS, PDM with its assembly codec) and the
# LCD displays and DisplayExt (need grlib) are left out.
# alwayslink: the prebuilt RF and BLE libraries (linked later) call into
# these; unused code is removed by --gc-sections.
_TI_LIB_COPTS = [
    "-std=c11",
    "-O3",
    "-w",
]

cc_library(
    name = "driverlib",
    # rfc.c is excluded: the prebuilt RF driver library carries its own copy
    # (with TI's prebuilt libraries the RF library's copy is the one linked).
    srcs = glob(
        ["source/ti/devices/cc13x2x7_cc26x2x7/driverlib/*.c"],
        allow_empty = False,
        exclude = ["source/ti/devices/cc13x2x7_cc26x2x7/driverlib/rfc.c"],
    ),
    copts = _TI_LIB_COPTS,
    includes = ["source/ti/devices/cc13x2x7_cc26x2x7"],
    deps = [":headers"],
    alwayslink = True,
)

