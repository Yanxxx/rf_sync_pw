cc_library(
    name = "drivers",
    srcs = ["source/ti/drivers/" + f for f in _DRIVERS_SRCS],
    copts = _TI_LIB_COPTS,
    deps = [
        ":driverlib",
        ":headers",
    ],
    alwayslink = True,
)

cc_library(
    name = "display",
    srcs = [
        "source/ti/display/Display.c",
        "source/ti/display/DisplayHost.c",
        "source/ti/display/DisplayUart2.c",
    ],
    hdrs = glob(["source/ti/display/*.h"]),
    copts = _TI_LIB_COPTS,
    deps = [
        ":drivers",
        ":headers",
    ],
    alwayslink = True,
)

# The RF driver is closed source; TI ships it prebuilt (also on GitHub).
_RF_LIB = select({
    ":cc13x2x7": ["source/ti/drivers/rf/lib/gcc/m4f/rf_multiMode_cc13x2.a"],
    ":cc26x2x7": ["source/ti/drivers/rf/lib/gcc/m4f/rf_multiMode_cc26x2.a"],
})

cc_library(
    name = "prebuilt_libs",
    srcs = _RF_LIB,
    deps = [
        ":display",
        ":drivers",
        ":driverlib",
    ],
)

# Everything a TI-drivers + FreeRTOS application needs from the SDK.
cc_library(
    name = "sdk",
    deps = [
        ":freertos_dpl",
        ":headers",
        ":posix_headers",
        ":prebuilt_libs",
    ],
)

# =============================================================================
# BLE5 stack (CC26x2x7, ROM-based "agama" stack) on FreeRTOS + GCC.
#
# TI ships basic_ble for CC2652R7 only for TI-RTOS7 (TI Clang/IAR). The stack
# libraries (OneLib.a / StackWrapper.a, built with IAR, EABI-compatible) do not
# reference TI-RTOS; the RTOS-specific part is ICall, which this repo replaces
# with //third_party/ti_ble5stack_freertos:icall_POSIX.c.
#
# The stack sources below must be compiled with the app's SysConfig output and
# build options, so they are exported as file lists and compiled by
# //targets/lp_cc2652r7:ble.bzl.
# =============================================================================

_BLE_INCLUDES = [
    "source/ti",
    "source/ti/ble5stack",
    "source/ti/ble5stack/controller/cc26xx/inc",
    "source/ti/ble5stack/inc",
    "source/ti/ble5stack/rom",
    "source/ti/ble5stack/common/cc26xx",
    "source/ti/ble5stack/icall/inc",
    "source/ti/ble5stack/hal/src/target/_common",
    "source/ti/ble5stack/common/cc26xx/npi/stack",
    "source/ti/ble5stack/hal/src/inc",
    "source/ti/ble5stack/heapmgr",
    "source/ti/ble5stack/profiles/dev_info",
    "source/ti/ble5stack/profiles/simple_profile",
    "source/ti/ble5stack/icall/src/inc",
    "source/ti/ble5stack/npi/src",
    "source/ti/ble5stack/osal/src/inc",
    "source/ti/ble5stack/services/src/saddr",
    "source/ti/ble5stack/services/src/sdata",
    "source/ti/common/nv",
    "source/ti/common/cc26xx",
    "source/ti/ble5stack/icall/src",
    "source/ti/drivers/dpl",
    "source/ti/devices/cc13x2x7_cc26x2x7",
    # bget.h for the FreeRTOS ICall port.
    "source/ti/ble5stack/common/cc26xx/freertos",
]

cc_library(
    name = "ble5stack_headers",
    hdrs = glob(
        [
            "source/ti/ble5stack/**/*.h",
            "source/ti/bleapp/**/*.h",
            "source/ti/common/**/*.h",
            "source/ti/display/*.h",
            "source/ti/devices/cc13x2x7_cc26x2x7/**/*.h",
        ],
        allow_empty = False,
    ),
    includes = _BLE_INCLUDES,
    deps = [
        ":headers",
        ":posix_headers",
    ],
)

# TI's build passes these to the compiler as response files (-D options);
# ble.bzl does the same.
exports_files([
    "source/ti/ble5stack/libraries/cc26x2r1/ble_r2.symbols",
    "source/ti/ble5stack/config/build_components.opt",
    "source/ti/ble5stack/config/factory_config.opt",
])

# Stack glue compiled with the app (same list as TI's basic_ble makefile,
# minus icall.c which is TI-RTOS only).
filegroup(
    name = "ble5stack_icall_srcs",
    srcs = [
        "source/ti/ble5stack/icall/app/ble_stack_api.c",
        "source/ti/ble5stack/icall/app/ble_user_config.c",
        "source/ti/ble5stack/icall/app/icall_api_lite.c",
        "source/ti/ble5stack/icall/src/icall_cc2650.c",
        "source/ti/ble5stack/icall/src/icall_user_config.c",
        "source/ti/ble5stack/icall/stack/ble_user_config_stack.c",
        "source/ti/ble5stack/rom/agama_r1/rom_init.c",
    ],
)

filegroup(
    name = "bleapp_util_srcs",
    srcs = [
        "source/ti/bleapp/ble_app_util/src/bleapputil_init.c",
        "source/ti/bleapp/ble_app_util/src/bleapputil_process.c",
        "source/ti/bleapp/ble_app_util/src/bleapputil_stack_callbacks.c",
        "source/ti/bleapp/ble_app_util/src/bleapputil_task.c",
    ],
)

filegroup(
    name = "bleapp_menu_srcs",
    srcs = ["source/ti/bleapp/menu_module/menu_module.c"],
)

filegroup(
    name = "bleapp_profile_srcs",
    srcs = [
        "source/ti/bleapp/profiles/simple_gatt/simple_gatt_profile.c",
        "source/ti/bleapp/services/dev_info/dev_info_service.c",
    ],
)

filegroup(
    name = "nv_srcs",
    srcs = [
        "source/ti/common/nv/crc.c",
        "source/ti/common/nv/nvocmp.c",
    ],
)

# Prebuilt stack. The ROM symbol file (ble_r2.symbols, an ELF file holding the
# addresses of the stack in the CC26x2 ROM) is linked with --just-symbols by
# @rf_sync_pw//third_party/ti_simplelink:ble_rom_symbols after removing a few
# IAR runtime symbols. The TI driver libraries are repeated in the group because the stack calls
# into them (RF, TRNG, AESCTRDRBG, ...).
_BLE_LIBS = [
    "source/ti/ble5stack/libraries/cc26x2r1/OneLib.a",
    "source/ti/ble5stack/libraries/cc26x2r1/StackWrapper.a",
]

cc_library(
    name = "ble5stack_libs",
    additional_linker_inputs = _BLE_LIBS,
    linkopts = ["-Wl,--start-group"] + ["$(location {})".format(l) for l in _BLE_LIBS] + ["-Wl,--end-group"],
    target_compatible_with = [":cc26x2x7"],
)
