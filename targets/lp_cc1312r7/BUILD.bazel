# Pigweed target for the TI LP_CC1312R7 LaunchPad (CC1312R7, Cortex-M4F)
# running FreeRTOS with TI SimpleLink drivers.

load("@pigweed//pw_build:merge_flags.bzl", "flags_from_dict")
load("@pigweed//third_party/freertos:flags.bzl", "FREERTOS_FLAGS")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(
    default_visibility = ["//visibility:public"],
    features = ["-layering_check"],
)

platform(
    name = "lp_cc1312r7",
    constraint_values = [
        "@freertos//:port_ARM_CM4F",
        "@ti_simplelink_sdk//:cc13x2x7",
        "@freertos//:malloc_heap_4",
        "@pigweed//pw_build/constraints/arm:cortex-m4",
        "@pigweed//pw_build/constraints/rtos:freertos",
        "@pigweed//pw_interrupt_cortex_m:compatible",
        "@platforms//cpu:armv7e-m",
        "@platforms//os:none",
    ],
    flags = flags_from_dict(FREERTOS_FLAGS | {
        "@freertos//:freertos_config": "//targets/lp_cc1312r7:freertos_config",
        "@pigweed//pw_assert:check_backend": "@pigweed//pw_assert_basic",
        "@pigweed//pw_assert:check_backend_impl": "@pigweed//pw_assert_basic:impl",
        "@pigweed//pw_build:default_module_config": "//targets/lp_cc1312r7:pigweed_module_config",
        "@pigweed//pw_interrupt:backend": "@pigweed//pw_interrupt_cortex_m:context",
        "@pigweed//pw_log:backend": "@pigweed//pw_log_basic",
        "@pigweed//pw_log:backend_impl": "@pigweed//pw_log_basic:impl",
        "@pigweed//pw_sys_io:backend": "//targets/lp_cc1312r7:sys_io_uart2",
        "@pigweed//pw_unit_test:backend": "@pigweed//pw_unit_test:light",
    }),
)

# Module configuration shared by all Pigweed modules for this target.
cc_library(
    name = "pigweed_module_config",
    defines = [
        # After printing a crash, spin until a debugger attaches. The default
        # (ABORT) calls std::abort(), which Pigweed's toolchain wraps into
        # PW_CRASH again -> infinite recursion that overruns the stack.
        "PW_ASSERT_BASIC_ACTION=PW_ASSERT_BASIC_ACTION_LOOP",
        "PW_THREAD_FREERTOS_CONFIG_JOINING_ENABLED=1",
    ],
)

# FreeRTOSConfig.h = SysConfig output + Pigweed additions. The kernel is
# shared by every app on this board, so there is one FreeRTOS config per
# board; tools/syscfg_gen.py checks that all apps' SysConfig agree on it.
cc_library(
    name = "freertos_config",
    hdrs = ["config/ti_syscfg_FreeRTOSConfig.h"],
    includes = ["config"],
    deps = ["//targets/ti_common:freertos_config_wrapper"],
)

cc_library(
    name = "linker_script",
    additional_linker_inputs = ["cc13x2x7_cc26x2x7_freertos.lds"],
    linkopts = [
        "-T$(location cc13x2x7_cc26x2x7_freertos.lds)",
        # TI's startup code (resetISR) replaces crt0.
        "-nostartfiles",
    ],
)

cc_library(
    name = "sys_io_uart2",
    srcs = ["sys_io_uart2.cc"],
    deps = [
        ":board_headers",
        "@pigweed//pw_status",
        "@pigweed//pw_sys_io:pw_sys_io.facade",
        "@ti_simplelink_sdk//:headers",
    ],
)

cc_library(
    name = "board_headers",
    hdrs = ["public/lp_cc1312r7/board.h"],
    strip_include_prefix = "public",
)

# Everything an application needs to run on this board: TI SDK (DPL, startup,
# POSIX, drivers), linker script and Pigweed glue. Per-app SysConfig output is
# added by lp_cc1312r7_app() (see app.bzl).
cc_library(
    name = "board",
    deps = [
        ":board_headers",
        "//targets/ti_common:freertos_glue",
        ":linker_script",
        ":sys_io_uart2",
        "@freertos",
        "@pigweed//pw_toolchain/arm_gcc:arm_none_eabi_gcc_support",
        "@ti_simplelink_sdk//:sdk",
    ],
    alwayslink = True,
)
